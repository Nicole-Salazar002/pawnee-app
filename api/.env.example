# Cadena de conexión de tu cluster de MongoDB Atlas.
# Para probar en esta computadora sin Atlas, deja MongoDB local
# (npm run db) y usa: mongodb://127.0.0.1:27017
MONGODB_URI=mongodb+srv://usuario:contrasena@cluster0.mongodb.net/?retryWrites=true&w=majority

# Base de datos para esta API (puede ser la misma de la Clase 1).
MONGODB_DB=pawnee_mongoose

# Puerto del servidor Express. En Render se asigna solo.
PORT=3000

# Origen permitido para el frontend publicado. Vacío permite cualquiera.
# CORS_ORIGIN=https://tu-frontend.onrender.com
